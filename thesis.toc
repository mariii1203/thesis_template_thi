\contentsline {subsection}{\numberline {9.1}Summary of the problem and approach}{43}{subsection.9.1}%
\contentsline {subsection}{\numberline {9.2}Summary of contributions}{43}{subsection.9.2}%
\contentsline {subsection}{\numberline {9.3}Answer to the research questions}{43}{subsection.9.3}%
\contentsline {paragraph}{\nonumberline RQ1 (Structural): How effectively can a deterministic baseline checker validate arc42-derived structure and detect missing/extra headings in real industrial documents?}{44}{paragraph*.98}%
\contentsline {paragraph}{\nonumberline RQ2 (Robustness): How can similarity-based alignment reduce false ``missing section'' findings caused by heading renames and variations?}{44}{paragraph*.100}%
\contentsline {paragraph}{\nonumberline RQ3 (Semantic \& Integrity): To what extent can an LLM-based audit, constrained to evidence-backed outputs, detect stubs and assess semantic adequacy relative to arc42 guidance?}{44}{paragraph*.102}%
\contentsline {paragraph}{\nonumberline RQ4 (Consistency): How can cross-view consistency checks be operationalized on text-centric arc42 documentation without assuming formal architecture models?}{44}{paragraph*.104}%
