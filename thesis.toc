\contentsline {subsection}{\numberline {8.3}Limitations}{40}{subsection.8.3}%
\contentsline {paragraph}{\nonumberline L1 --- Template dependence and organizational variation.}{40}{paragraph*.88}%
\contentsline {paragraph}{\nonumberline L2 --- False positives from heuristic integrity checks.}{40}{paragraph*.90}%
\contentsline {paragraph}{\nonumberline L3 --- Residual non-determinism and sensitivity in LLM-based judgments.}{40}{paragraph*.92}%
\contentsline {paragraph}{\nonumberline L4 --- Limited understanding of diagrams and external artifacts.}{40}{paragraph*.94}%
\contentsline {paragraph}{\nonumberline L5 --- Consistency checks limited to what is explicitly expressed in text.}{40}{paragraph*.96}%
