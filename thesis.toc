\contentsline {paragraph}{\nonumberline S1 --- Staged design improves acceptance and auditability.}{39}{paragraph*.76}%
\contentsline {paragraph}{\nonumberline S2 --- Robustness to naming variation without sacrificing explainability.}{39}{paragraph*.78}%
\contentsline {paragraph}{\nonumberline S3 --- Guidance-aware semantic validation.}{39}{paragraph*.80}%
\contentsline {paragraph}{\nonumberline S4 --- Evidence-backed outputs support industrial review workflows.}{40}{paragraph*.82}%
